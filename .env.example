# Runtime secrets — скопируйте в .env и заполните перед `docker compose up`
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-random-64-chars
# Публичный адрес фронтенда (используется бэком для CORS)
CORS_ORIGIN=http://localhost:8080
# Адрес API, куда обращается фронт (для reg.cloud сюда идёт https://api.вашдомен)
VITE_API_URL=http://localhost:3001
